homelab-ca.crt

# ansible secrets and generated files
/ansible/.env
/ansible/kubeconfig
*.retry

# Crash log files
crash.log
crash.*.log

# SOPS / age — private keys must never be committed.
# Encrypted *.enc.yaml files ARE committed; these patterns catch the plaintext.
*.agekey
keys.txt
*-decrypted.yaml
secrets.yaml
!*.enc.yaml

# Backup archives live on the node (/var/backups/homelab), never in the repo.
# This is only a backstop against a stray copy landing here.
*.tar.gz
homelab-*.tar.gz

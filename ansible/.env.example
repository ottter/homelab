# Copy this to .env and fill in your values.
# Source before running: set -a && . .env && set +a

# Sudo password for the server user (used for ansible become)
# Quotes are required if the password contains special characters
HOMELAB_PASSWORD="your-sudo-password-here"

# GitHub PAT with 'repo' scope — used by `flux bootstrap` to commit the
# flux-system manifests. https://github.com/settings/tokens
GITHUB_TOKEN="ghp_your_token_here"
